# Names only. Never put real values in this file.
# Local: copy to .env.local (Next) and .dev.vars (wrangler dev). Production: `wrangler secret put <NAME>`.

# Quote Worker (/api/quote)
# Where each lead is stored is a Cloudflare binding (KV or D1) set in wrangler config, not an env var.
ALLOWED_ORIGIN=
LEAD_ALERT_TO=
LEAD_ALERT_FROM=
EMAIL_API_KEY=
SPAM_TIME_TRAP_SECRET=
TURNSTILE_SECRET_KEY=

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Deploy (CI or local wrangler)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
