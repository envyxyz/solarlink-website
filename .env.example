# Copy to .env.local. Real values never go in chat or in git.

# "production" makes pages indexable. Leave unset everywhere else (local, preview, staging): they stay noindex.
PUBLIC_SITE_ENV=

# Analytics (Phase 8). Use the existing GA4 property so history continues.
PUBLIC_GA4_ID=
PUBLIC_POSTHOG_KEY=

# Search Console and Bing verification (Phase 8, before launch)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
