{
  "name": "solarlink-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sizing-check.mjs && node scripts/check-content.mjs --pre && next build && node scripts/check-content.mjs --post",
    "start": "next start",
    "lint": "eslint && node scripts/check-css.mjs",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs --pre",
    "check:claims": "node scripts/check-content.mjs --post",
    "check:sizing": "node scripts/sizing-check.mjs",
    "images": "node scripts/images.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.21.0"
}
