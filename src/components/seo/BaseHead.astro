---
// Every page's <head>. Pages pass copy from src/content.ts; nothing here is hard-coded per page.
import { Font } from "astro:assets";
import "../../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Path of the Open Graph image under /public. */
  ogImage?: string;
  /** Force noindex for a page that must never be indexed (legal stubs, thank-you pages). */
  noindex?: boolean;
  /** JSON-LD objects for this page. Facts must match the visible page. */
  schema?: Record<string, unknown>[];
  /** Load the mono face on pages that show data (tools, price tables). */
  mono?: boolean;
}

const { title, description, ogImage = "/og/default.jpg", noindex = false, schema = [], mono = false } = Astro.props;

// Only the production build is indexable. Previews and staging stay noindex (docs/SEO-MIGRATION.md).
const isProduction = import.meta.env.PUBLIC_SITE_ENV === "production";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = isProduction && !noindex ? "index, follow, max-image-preview:large" : "noindex, nofollow";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<Font cssVariable="--font-outfit" preload={[{ subset: "latin", style: "normal" }]} />
<Font cssVariable="--font-unbounded" preload={[{ subset: "latin", style: "normal" }]} />
{mono && <Font cssVariable="--font-geist-mono" />}

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060705" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9fbf8" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="SolarLink" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(ogImage, Astro.site).href} />
<meta property="og:locale" content="en_PK" />
<meta name="twitter:card" content="summary_large_image" />

{schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
