{
  // One Worker: static assets from out/, plus POST /api/quote. Not deployed yet (CLAUDE.md: ask Ameer first).
  "name": "solarlink-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* wakes the Worker; every other request is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Replace the id with the real namespace: `wrangler kv namespace create LEADS`.
  "kv_namespaces": [{ "binding": "LEADS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  // 5 quote submissions per IP per 60 seconds.
  "ratelimits": [{ "name": "RATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // "1" hands out WhatsApp numbers the client has not confirmed. Review builds only: `pnpm preview` sets it, deploy does not.
  "vars": { "SHOW_UNCONFIRMED": "0" }
}
